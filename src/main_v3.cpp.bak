#include <Arduino.h>
#include "modulo_display.h"

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println(F("[TESTE] Inicializando Display..."));
    inicializarDisplay();

    // ------------------------------------------------------------------------
    // TESTE 1: Verificação de Pixels Queimados (TestarPixelsTela)
    // ------------------------------------------------------------------------
    Serial.println(F("[TESTE 1] Tela cheia (Branca) por 3 segundos..."));
    testarPixelsTela();
    delay(3000);

    // ------------------------------------------------------------------------
    // TESTE 2: AtualizarStatusTela com Fonte Tamanho 1
    // ------------------------------------------------------------------------
    Serial.println(F("[TESTE 2] Fonte Tamanho 1"));
    atualizarStatusTela("Fonte Tam 1\nCentralizada", 1);
    delay(2500);

    // ------------------------------------------------------------------------
    // TESTE 3: AtualizarStatusTela com Fonte Tamanho 2
    // ------------------------------------------------------------------------
    Serial.println(F("[TESTE 3] Fonte Tamanho 2"));
    atualizarStatusTela("TAM 2", 2);
    delay(2500);

    // ------------------------------------------------------------------------
    // TESTE 4: AtualizarStatusTela com Fonte Tamanho 3
    // ------------------------------------------------------------------------
    Serial.println(F("[TESTE 4] Fonte Tamanho 3"));
    atualizarStatusTela("OK", 3);
    delay(2500);

    Serial.println(F("[TESTE] Ciclo de testes finalizado. Entrando no loop..."));
}

void loop() {
    // Alterna periodicamente entre o teste de pixels e diferentes tamanhos de fonte
    testarPixelsTela();
    delay(2000);

    atualizarStatusTela("Tamanho 1", 1);
    delay(2000);

    atualizarStatusTela("Tamanho 2", 2);
    delay(2000);

    atualizarStatusTela("Tamanho 3", 3);
    delay(2000);

    atualizarStatusTela("Tamanho 4", 4);
    delay(2000);

    atualizarStatusTela("Tamanho 5", 5);
    delay(2000);
}